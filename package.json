{
  "name": "property-price-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.19.0 <25" },
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "npm run build -w shared && concurrently -k 'npm run dev -w server' 'npm run dev -w client'",
    "dev:client": "npm run build -w shared && npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run build -w shared && npm run typecheck -w server && npm run typecheck -w client && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "npm run build -w shared && vitest run",
    "test:e2e": "playwright test",
    "db:up": "node scripts/db-compose.mjs up",
    "db:down": "node scripts/db-compose.mjs down",
    "db:ps": "node scripts/db-compose.mjs ps",
    "db:logs": "node scripts/db-compose.mjs logs",
    "db:check": "node --import tsx server/src/infrastructure/db-check-cli.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.mjs",
    "prisma:validate": "node --env-file=server/.env node_modules/prisma/build/index.js validate",
    "smoke:providers": "npm run build -w shared && node --import tsx scripts/smoke/cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0", "@testing-library/jest-dom": "7.0.1", "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.71.0", "@typescript-eslint/parser": "8.71.0", "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5", "eslint": "10.11.0", "jsdom": "30.1.1", "prisma": "6.12.0", "supertest": "7.3.0",
    "tsx": "4.23.15", "typescript": "5.9.3", "vite": "8.3.1", "vitest": "5.0.2"
  }
}
